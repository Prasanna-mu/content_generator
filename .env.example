# Content Generator - Sprint 2 Environment Configuration

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Default Generation Settings
DEFAULT_NUM_LESSONS=5
DEFAULT_SUBTOPICS_PER_LESSON=4
DEFAULT_CONTENT_QUALITY=intermediate
DEFAULT_CONTENT_LENGTH=medium
DEFAULT_QUIZ_QUESTION_COUNT=5
DEFAULT_QUIZ_DIFFICULTY=intermediate
DEFAULT_QUESTION_BANK_COUNT=10

# Output Configuration
OUTPUT_BASE_DIR=output

# Parallel Processing Configuration
WORKER_COUNT=4

# Web Search Configuration (Sprint 2)
SEARCH_ENGINE=duckduckgo
SEARCH_TIMEOUT=10
RESULTS_PER_QUERY=5
MAX_SEARCH_QUERIES=5
MAX_CONTENT_CHARS=50000

# Optional: API Keys for premium search engines
# SERPER_API_KEY=your_serper_api_key_here
# BING_API_KEY=your_bing_api_key_here